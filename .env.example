MODEL_PROVIDER=azure

# API tools
# Required only if you want address lookup / distance / weather-by-address features.
# Open-Meteo itself does not require an API key.
POSITIONSTACK_API_KEY=your_positionstack_api_key

# Azure OpenAI mode
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT=gpt-4o-ArturG

# Ollama mode
# MODEL_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=gemma3:27b
# OLLAMA_API_KEY=ollama
